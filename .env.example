# Server port (default: 3000)
PORT=3000

# TURN server credentials (optional — app works with STUN only, but TURN improves connectivity)
# Sign up for free at https://www.metered.ca/stun-turn to get these values
TURN_URL=turn:a.relay.metered.ca:443
TURN_USERNAME=your_username_here
TURN_CREDENTIAL=your_credential_here
